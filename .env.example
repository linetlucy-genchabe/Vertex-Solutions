# Copy these into Railway → your service → Variables
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=vertexsolutions.co.ke,www.vertexsolutions.co.ke,.up.railway.app
CSRF_TRUSTED_ORIGINS=https://vertexsolutions.co.ke,https://www.vertexsolutions.co.ke,https://*.up.railway.app
# DATABASE_URL is added automatically when you add a Railway Postgres database
MEDIA_ROOT=/data/media

# Owner login for the dashboard (created on first deploy)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=choose-a-strong-password

# M-Pesa Daraja — leave blank for demo mode
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://vertexsolutions.co.ke/mpesa/callback/
